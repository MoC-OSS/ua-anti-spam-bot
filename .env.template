##########
##########
########## Environment configuration for ua-anti-spam-bot
##########
########## Validation: Zod schemas in src/shared/config/env.schema.ts
########## Bot validation: src/shared/config/bot.schema.ts
########## Server validation: src/shared/config/server.schema.ts
##########
########## To add a new variable:
########## 1. Add it to the appropriate domain in env.schema.ts
########## 2. If required, add a check in bot.schema.ts or server.schema.ts
########## 3. Add it here with documentation
##########
##########

######
######
###### Used for both bot and server process. 🤖 🖥️
######
######

# Bot token to authenticate in Telegram.
# Required for both bot and server.
# Obtain from @BotFather.
BOT_TOKEN=

# Current environment. Values: local | develop | production
# Default: develop
ENV=

# Rank for tensorflow spam checking (0 to 1).
# Default: 0.9
TENSOR_RANK=

# Google service account JSON credentials for Google Sheets access.
# Required when DISABLE_GOOGLE_API is not true.
GOOGLE_CREDITS=

# ID of the main Google spreadsheet used by the bot.
# Required when DISABLE_GOOGLE_API is not true.
GOOGLE_SPREADSHEET_ID=

# AWS S3 bucket name.
S3_BUCKET=

# S3 path prefix.
S3_PATH=

# AWS region for S3.
AWS_REGION=


######
######
###### Used only for bot process. 🤖
######
######

# Port of the bot health-check server.
# Default: 3010
BOT_PORT=

# Host of the bot health-check server.
# Default: localhost
BOT_HOST=

# Redis connection URL.
# Default: redis://localhost:6379
REDIS_URL=

# Stfalcon API key for air raid alerts.
# Required when DISABLE_ALARM_API is not true.
# Obtain from api.ukrainealarm.com.
ALARM_KEY=

# Comma-separated Telegram user IDs for swindler statistics access.
USERS_FOR_SWINDLERS_STATISTIC_WHITELIST=00000001, 0000002, -10000000

# Comma-separated Telegram user IDs for private features.
USERS_WHITELIST=00000001, 0000002, -10000000

# URL of the frontend application (used for CORS and redirects).
# Example: https://ua-anti-spam-bot-front.vercel.app
FRONTEND_HOST=

# Telegram WebApp URL for bot settings.
# Example: t.me/UaAntiSpam_bot/settings
WEB_VIEW_URL=


######
######
###### Used only for express server. 🖥️
######
######

# Public base URL of the express server.
# Used to register the alarm webhook with Stfalcon API.
# Example: https://my-alb.us-east-1.elb.amazonaws.com
ALARM_WEBHOOK_BASE_URL=

# RSA public key (PEM) for webhook signature verification.
# Used to verify X-Webhook-Signature on incoming alarm webhooks.
# Validated at startup via Zod — invalid PEM will be reported immediately.
ALARM_WEBHOOK_PUBLIC_KEY_PEM=

# Port of the express ML server.
# Default: 3000
PORT=

# Host of the express ML server.
# Default: localhost
HOST=


######
######
###### TensorFlow configuration. 🤖 🖥️
######
######

# TF C++ log verbosity. 0=ALL, 1=WARN+, 2=ERROR+ (production), 3=FATAL.
TF_CPP_MIN_LOG_LEVEL=

# TF intra-op threads. Defaults to CPU core count.
TF_NUM_INTRAOP_THREADS=

# TF inter-op threads. Consider 1 for sequential inference.
TF_NUM_INTEROP_THREADS=


######
######
###### Feature flags and testing. 🧪
######
######

# Run tensor/ML locally instead of via server.
# Default: false
USE_SERVER=false

# Override CREATOR_ID for local testing.
CREATOR_ID=

# Enable verbose debug logging.
# Default: false
DEBUG=

# Show why bot skipped a message.
# Default: false
DEBUG_MIDDLEWARE=

# Disable Google Sheets API calls.
# When true, skips GOOGLE_CREDITS and GOOGLE_SPREADSHEET_ID validation.
# Default: false
DISABLE_GOOGLE_API=

# Disable Stfalcon alarm API integration.
# When true, skips ALARM_KEY validation.
# Default: false
DISABLE_ALARM_API=

# Disable sending messages to the logs chat.
# Default: false
DISABLE_LOGS_CHAT=

# Set automatically during unit testing.
# Default: false
UNIT_TESTING=


######
######
###### Userbot (research). 🐬
######
######

# Telegram app ID from https://my.telegram.org/auth
USERBOT_APP_ID=

# Telegram app hash.
USERBOT_API_HASH=

# Phone for userbot login.
USERBOT_LOGIN_PHONE=

# Login verification code.
USERBOT_LOGIN_CODE=


######
######
###### Legacy / Deprecated
######
######

# Legacy TF testing flag.
TEST_TENSOR=

# Legacy PostgreSQL variables.
POSTGRES_PASSWORD=
PGHOST=
PGUSER=
PGDATABASE=
PGPORT=
